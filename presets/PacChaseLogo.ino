/*
  Notes for Kevin

  Images must NOT have even lines reversed (this makes math too complicated)

  Function reverses even lines as it goes.

  % is modulus which wraps values 0 % 2 = 0, 1 % 2 = 2, 3 % 2 = 0 key to keeping things in check.

*/
// Function to render part of sprite
void renderPartOfSprite(const byte sprite[256], const uint32_t palette[], int spriteWidth, int spriteHeight, int offsetX, int offsetY) {
  for(int x = 0; x < NUM_COLS; x++) {
    for(int y = 0; y < NUM_ROWS; y++) {
      bool isEvenRow = y % 2 == 0;
      int position = (y + offsetY) * spriteWidth;
      if (isEvenRow) {
        position += ((offsetX + (NUM_COLS - x - 1)) % spriteWidth); // Backwards
      } else {
        position += ((offsetX + x) % spriteWidth); // Forwards
      }
      position = position % (spriteWidth * spriteHeight); // Wrap around

      byte index = pgm_read_byte(&(sprite[position]));
      uint32_t rgb = pgm_read_dword(&(palette[index]));
      leds[y * NUM_COLS + x] = rgb;
    }
  }
  FastLED.show();
}


